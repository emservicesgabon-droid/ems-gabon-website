# === Envoi des emails des formulaires (contact, devis, rendez-vous) via RESEND ===
# Le plan Zoho gratuit ne permet pas l'envoi SMTP externe : on utilise Resend
# (API HTTPS, fiable en serverless). La reception reste sur la boite Zoho.

# Cle API Resend (https://resend.com > API Keys). OBLIGATOIRE.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Expediteur : une adresse du (sous-)domaine VERIFIE dans Resend.
# Domaine verifie ici = no-reply.emsgabon.com (n'impacte pas le site ni la messagerie Zoho).
MAIL_FROM=EMS GABON <noreply@no-reply.emsgabon.com>

# Destinataire des notifications (arrive dans la boite Zoho ; contact@ = alias de ems@).
MAIL_TO=contact@emsgabon.com
