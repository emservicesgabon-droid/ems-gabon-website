# === Configuration SMTP (envoi des emails des formulaires) ===
# Compte Gmail utilise pour envoyer les emails (contact, devis, rendez-vous).
SMTP_USER=ems@emsgabon.com

# Mot de passe d'application Gmail (16 caracteres, PAS le mot de passe du compte).
# A generer sur : https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx xxxx xxxx xxxx

# Adresse qui recoit les messages des formulaires (par defaut = SMTP_USER).
SMTP_TO=ems@emsgabon.com
