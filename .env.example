# === Configuration SMTP (envoi des emails des formulaires) ===
# La messagerie de emsgabon.com est hebergee chez ZOHO (MX = *.zoho.com).
# Serveur SMTP Zoho (datacenter global). En UE : smtp.zoho.eu
SMTP_HOST=smtp.zoho.com
# Port : 465 (SSL, defaut) ou 587 (STARTTLS)
SMTP_PORT=465

# Compte Zoho utilise pour envoyer les emails (contact, devis, rendez-vous).
SMTP_USER=ems@emsgabon.com

# Mot de passe d'application ZOHO (PAS le mot de passe du compte).
# A generer sur : Zoho Mail > Parametres > Securite > Mots de passe d'application
# (activer aussi l'acces IMAP/SMTP dans Parametres > Mail Accounts si besoin).
SMTP_PASS=xxxxxxxxxxxxxxxx

# Adresse qui recoit les messages des formulaires (par defaut = SMTP_USER).
SMTP_TO=contact@emsgabon.com
